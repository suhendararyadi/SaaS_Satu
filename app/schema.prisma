  scheduledAt      DateTime?
  createdById      String
  updatedById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([schoolId, type, slug])
  @@index([schoolId, type, status])
  @@index([schoolId, status, scheduledAt])
  @@index([schoolId, publishedAt])
}

model SchoolSiteNavItem {
  id        String                @id @default(uuid())
  schoolId  String
  school    School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  location  SchoolSiteNavLocation
  label     String
  type      SchoolSiteNavType
  contentId String?
  href      String?
  order     Int                   @default(0)
  isVisible Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([schoolId, location, order])
}

model SchoolSiteMedia {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fileId      String?
  url         String
  altText     String
  caption     String?
  width       Int?
  height      Int?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, createdAt])
}

model SchoolSiteRevision {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String?
  action       String
  snapshot     Json
  createdById  String
  createdAt    DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, resourceType, resourceId, createdAt])
}

model GptResponse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content String
}

model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  description String
  time        String  @default("1")
  isDone      Boolean @default(false)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  name  String
  type  String
  s3Key String

  @@unique([userId, s3Key])
  @@index([userId, createdAt])
}

model DailyStats {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @default(now())

  totalViews                Int?
  prevDayViewsChangePercent String?
  userCount                 Int     @default(0)
  paidUserCount             Int     @default(0)
  userDelta                 Int     @default(0)
  paidUserDelta             Int     @default(0)
  totalRevenue              Float?
  totalProfit               Float?

  sources PageViewSource[]
}

model PageViewSource {
  name String
  date DateTime @default(now())

  dailyStats   DailyStats? @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId Int?

  visitors Int

  @@id([date, name])
}

model Logs {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  message String
  level   String
}

model ContactFormMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
}
