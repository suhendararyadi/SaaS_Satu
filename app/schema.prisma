datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  DUDI_MENTOR
}

enum SubscriptionTier {
  FREE_TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum SchoolLevel {
  SD_MI
  SMP_MTS
  SMA_SMK
}

enum SchoolSiteStatus {
  DRAFT
  PUBLISHED
}

enum CmsContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsContentType {
  PAGE
  NEWS
  EVENT
  ANNOUNCEMENT
}

enum SchoolSiteNavLocation {
  HEADER
  FOOTER
}

enum SchoolSiteNavType {
  PAGE
  ROUTE
  EXTERNAL
}

enum WakasekRole {
  KURIKULUM
  KESISWAAN
  SARPRAS
  HUMAS_HUBIN
}

enum SchoolStaffAssignmentRole {
  PRINCIPAL
  DUTY_TEACHER
  DEPARTMENT_HEAD
  EXTRACURRICULAR_ADVISOR
  OTHER
}

enum FollowUpStatus {
  FINDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELED
}

enum FollowUpSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FollowUpSourceType {
  ATTENDANCE
  PKL_EWS
  DUTY_TEACHER
  HOMEROOM
  WAKASEK
  STUDENT_AFFAIRS
  SARPRAS
  SYSTEM
  MANUAL
}

enum FollowUpEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENT
  UPDATED
}

enum AssetCondition {
  GOOD
  FAIR
  DAMAGED
  LOST
  MAINTENANCE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DISPOSED
}

enum AssetMaintenanceStatus {
  REPORTED
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum AssetMovementType {
  ACQUISITION
  TRANSFER
  REPAIR
  RETURN
  DISPOSAL
  ADJUSTMENT
}

enum StudentViolationStatus {
  RECORDED
  IN_REVIEW
  RESOLVED
  CANCELED
}

enum StudentAchievementLevel {
  SCHOOL
  DISTRICT
  REGENCY
  PROVINCE
  NATIONAL
  INTERNATIONAL
}

enum StudentCoachingType {
  COACHING
  COUNSELING
  PARENT_MEETING
}

enum StudentCoachingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum StudentPermitType {
  SICK
  EXIT
  DISPENSATION
  ACTIVITY
  OTHER
}

enum StudentPermitStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURNED
  CANCELED
}

enum StudentAffairsEntityType {
  VIOLATION
  ACHIEVEMENT
  COACHING
  PERMIT
}

enum StudentAffairsEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  COMMENT
}

enum AttendanceCalendarDayType {
  SCHOOL_DAY
  HOLIDAY
  NATIONAL_HOLIDAY
  SEMESTER_BREAK
  SCHOOL_EVENT
  EXAM_DAY
  SPECIAL_SCHEDULE
}

enum AttendanceEventType {
  SELF_CHECK_IN
  SELF_CHECK_OUT
  DUTY_LATE
  DUTY_EARLY_LEAVE
  DUTY_DISPENSATION
  SUBJECT_ATTENDANCE
  HABIT_ATTENDANCE
  PERMIT_STATUS
  HOMEROOM_OVERRIDE
  SYSTEM_RECONCILIATION
}

enum AttendanceGeofenceStatus {
  INSIDE
  OUTSIDE
  UNVERIFIED
}

enum AttendanceReconciliationStatus {
  AUTO
  NEEDS_REVIEW
  VERIFIED
  MANUAL
}

enum AttendanceActivityStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELED
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email    String?  @unique
  username String?  @unique
  name     String?
  isAdmin  Boolean  @default(false)
  role     UserRole @default(STUDENT)

  schoolId           String?
  school             School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  teacherProfile     TeacherProfile?
  studentProfile     StudentProfile?
  wakasekAssignments WakasekAssignment[]
  staffAssignments   SchoolStaffAssignment[]

  classRoomId     String?
  classRoom       ClassRoom?  @relation("StudentClass", fields: [classRoomId], references: [id])
  homeroomClasses ClassRoom[] @relation("HomeroomClasses")

  studentPlacements Placement[]        @relation("StudentPlacements")
  teacherPlacements Placement[]        @relation("TeacherPlacements")
  mentorPlacements  Placement[]        @relation("MentorPlacements")
  dudiMentorProfile DudiMentorProfile?

  teacherCourses            LmsCourse[]               @relation("TeacherCourses")
  attendanceRecords         LmsAttendanceRecord[]
  assignmentSubmissions     LmsSubmission[]
  assessmentResults         LmsAssessmentResult[]
  dutyReports               DutyTeacherReport[]
  dailyAttendances          SchoolDailyAttendance[]   @relation("DailyAttendanceStudent")
  recordedDailyAttendances  SchoolDailyAttendance[]   @relation("DailyAttendanceRecorder")
  followUpSubjectCases      SchoolFollowUpCase[]      @relation("FollowUpSubjectStudent")
  followUpAssignedCases     SchoolFollowUpCase[]      @relation("FollowUpAssignee")
  followUpCreatedCases      SchoolFollowUpCase[]      @relation("FollowUpCreator")
  followUpResolvedCases     SchoolFollowUpCase[]      @relation("FollowUpResolver")
  followUpEvents            SchoolFollowUpEvent[]     @relation("FollowUpEventActor")
  facilityResponsibilities  FacilityRoom[]            @relation("FacilityResponsible")
  assetResponsibilities     AssetItem[]               @relation("AssetResponsible")
  reportedAssetMaintenances AssetMaintenance[]        @relation("MaintenanceReporter")
  assignedAssetMaintenances AssetMaintenance[]        @relation("MaintenanceAssignee")
  assetMovements            AssetMovement[]           @relation("AssetMovementActor")
  studentViolations         StudentViolation[]        @relation("ViolationStudent")
  reportedStudentViolations StudentViolation[]        @relation("ViolationReporter")
  handledStudentViolations  StudentViolation[]        @relation("ViolationHandler")
  studentAchievements       StudentAchievement[]      @relation("AchievementStudent")
  recordedAchievements      StudentAchievement[]      @relation("AchievementRecorder")
  studentCoachings          StudentCoaching[]         @relation("CoachingStudent")
  recordedStudentCoachings  StudentCoaching[]         @relation("CoachingRecorder")
  assignedStudentCoachings  StudentCoaching[]         @relation("CoachingAssignee")
  studentPermits            StudentPermit[]           @relation("PermitStudent")
  recordedStudentPermits    StudentPermit[]           @relation("PermitRecorder")
  approvedStudentPermits    StudentPermit[]           @relation("PermitApprover")
  studentAffairsEvents      StudentAffairsEvent[]     @relation("AffairsEventStudent")
  actedStudentAffairsEvents StudentAffairsEvent[]     @relation("AffairsEventActor")
  notificationStates        SchoolNotificationState[]
  attendanceEvents          StudentAttendanceEvent[]    @relation("AttendanceEventStudent")
  actedAttendanceEvents     StudentAttendanceEvent[]    @relation("AttendanceEventActor")
  verifiedDailyAttendances  SchoolDailyAttendance[]     @relation("DailyAttendanceVerifier")
  createdAttendanceActivities AttendanceActivity[]      @relation("AttendanceActivityCreator")
  activityAttendanceRecords AttendanceActivityRecord[]  @relation("ActivityAttendanceStudent")
  recordedActivityAttendanceRecords AttendanceActivityRecord[] @relation("ActivityAttendanceRecorder")

  paymentProcessorUserId        String?   @unique
  lemonSqueezyCustomerPortalUrl String? // Lemon Squeezy portal
  subscriptionStatus            String? // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan              String? // 'hobby', 'pro'
  datePaid                      DateTime?
  credits                       Int       @default(3)

  gptResponses        GptResponse[]
  contactFormMessages ContactFormMessage[]
  tasks               Task[]
  files               File[]

  @@index([schoolId, role])
  @@index([schoolId, classRoomId])
}

model School {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  name      String
  slug      String      @unique
  npsn      String?
  address   String?
  city      String?
  province  String?
  phone     String?
  email     String?
  logoUrl   String?
  level     SchoolLevel @default(SMA_SMK)

  tier               SubscriptionTier @default(FREE_TRIAL)
  studentQuota       Int              @default(50)
  subscriptionStatus String           @default("active")
  subscriptionEndsAt DateTime?

  users                User[]
  departments          Department[]
  classRooms           ClassRoom[]
  academicYears        AcademicYear[]
  companies            Company[]
  placements           Placement[]
  pklPeriods           PklPeriod[]
  companyDepartments   CompanyDepartment[]
  pklCompanyCapacities PklCompanyCapacity[]
  dudiMentorProfiles   DudiMentorProfile[]
  pklWorkSchedules      PklWorkSchedule[]
  pklPlacementEvents    PklPlacementEvent[]
  lmsCourses           LmsCourse[]
  dutyReports          DutyTeacherReport[]
  dailyAttendances     SchoolDailyAttendance[]
  wakasekAssignments   WakasekAssignment[]
  staffAssignments     SchoolStaffAssignment[]
  followUpCases        SchoolFollowUpCase[]
  facilityRooms        FacilityRoom[]
  assetCategories      AssetCategory[]
  assets               AssetItem[]
  assetMaintenances    AssetMaintenance[]
  assetMovements       AssetMovement[]
  studentViolations    StudentViolation[]
  studentAchievements  StudentAchievement[]
  studentCoachings     StudentCoaching[]
  studentPermits       StudentPermit[]
  studentAffairsEvents StudentAffairsEvent[]
  notificationStates   SchoolNotificationState[]
  attendancePolicy     SchoolAttendancePolicy?
  attendanceCalendarDays SchoolCalendarDay[]
  attendanceEvents     StudentAttendanceEvent[]
  attendanceActivities AttendanceActivity[]
  site                 SchoolSite?
  siteContents         SchoolSiteContent[]
  siteNavItems         SchoolSiteNavItem[]
  siteMedia            SchoolSiteMedia[]
  siteRevisions        SchoolSiteRevision[]
}

model Department {
  id               String                  @id @default(uuid())
  schoolId         String
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code             String
  name             String
  classes          ClassRoom[]
  staffAssignments SchoolStaffAssignment[]
  companyLinks     CompanyDepartment[]
  pklCapacities    PklCompanyCapacity[]
  placements       Placement[]

  @@unique([schoolId, code])
}

model AcademicYear {
  id               String                  @id @default(uuid())
  schoolId         String
  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearName         String // "2026/2027"
  semester         String // "GANJIL" | "GENAP"
  isActive         Boolean                 @default(false)
  classes          ClassRoom[]
  courses          LmsCourse[]
  dailyAttendances SchoolDailyAttendance[]
  attendanceActivities AttendanceActivity[]
  staffAssignments SchoolStaffAssignment[]
  pklPeriods       PklPeriod[]

  @@unique([schoolId, yearName, semester])
  @@index([schoolId, isActive])
}

model ClassRoom {
  id                String                  @id @default(uuid())
  schoolId          String
  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYearId    String
  academicYear      AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevel        Int // 1..6 (SD), 7..9 (SMP), 10..13 (SMA/SMK)
  name              String // "XII RPL 1"
  homeroomTeacherId String?
  homeroomTeacher   User?                   @relation("HomeroomClasses", fields: [homeroomTeacherId], references: [id])
  students          User[]                  @relation("StudentClass")
  lmsCourses        LmsCourse[]
  dailyAttendances  SchoolDailyAttendance[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
  @@index([schoolId, departmentId])
  @@index([schoolId, homeroomTeacherId])
}

model SchoolDailyAttendance {
  id                   String                         @id @default(uuid())
  schoolId             String
  school               School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId       String
  academicYear         AcademicYear                   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classRoomId          String
  classRoom            ClassRoom                      @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  studentId            String
  student              User                           @relation("DailyAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  dateOnly             String
  status               String
  notes                String?
  arrivalAt            DateTime?
  checkOutAt           DateTime?
  lateMinutes          Int?
  earlyLeave           Boolean                        @default(false)
  reconciliationStatus AttendanceReconciliationStatus @default(MANUAL)
  evidenceSummary      Json?
  verifiedById         String?
  verifiedBy           User?                          @relation("DailyAttendanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt           DateTime?
  recordedById         String
  recordedBy           User                           @relation("DailyAttendanceRecorder", fields: [recordedById], references: [id])
  recordedAt           DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@unique([schoolId, studentId, dateOnly])
  @@index([schoolId, dateOnly])
  @@index([schoolId, classRoomId, dateOnly])
  @@index([studentId, dateOnly])
  @@index([recordedById])
  @@index([schoolId, reconciliationStatus, dateOnly])
  @@index([verifiedById])
}

model SchoolAttendancePolicy {
  id                       String   @id @default(uuid())
  schoolId                 String   @unique
  school                   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timezone                 String   @default("Asia/Jakarta")
  latitude                 Float?
  longitude                Float?
  radiusMeters             Int      @default(100)
  maxGpsAccuracyMeters     Int      @default(50)
  checkInOpen              String   @default("05:30")
  lateAfter                String   @default("07:00")
  checkInClose             String   @default("09:00")
  checkOutOpen             String   @default("14:00")
  checkOutClose            String   @default("18:00")
  allowStudentCheckIn      Boolean  @default(true)
  allowStudentCheckOut     Boolean  @default(true)
  requireCheckInSelfie     Boolean  @default(true)
  requireCheckOutSelfie    Boolean  @default(false)
  workingDays              String   @default("1,2,3,4,5")
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SchoolCalendarDay {
  id                    String                    @id @default(uuid())
  schoolId              String
  school                School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dateOnly              String
  type                  AttendanceCalendarDayType
  label                 String
  notes                 String?
  checkInOpenOverride   String?
  lateAfterOverride     String?
  checkInCloseOverride  String?
  checkOutOpenOverride  String?
  checkOutCloseOverride String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([schoolId, dateOnly])
  @@index([schoolId, type, dateOnly])
}

model StudentAttendanceEvent {
  id              String                    @id @default(uuid())
  schoolId        String
  school          School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         User                      @relation("AttendanceEventStudent", fields: [studentId], references: [id], onDelete: Cascade)
  dateOnly        String
  type            AttendanceEventType
  status          String
  source          String
  sourceKey       String?
  occurredAt      DateTime                  @default(now())
  actorId         String?
  actor           User?                     @relation("AttendanceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  latitude        Float?
  longitude       Float?
  gpsAccuracy     Float?
  distanceMeters  Float?
  geofenceStatus  AttendanceGeofenceStatus?
  evidenceKey     String?
  notes           String?
  metadata        Json?
  createdAt       DateTime                  @default(now())

  @@unique([schoolId, sourceKey])
  @@index([schoolId, studentId, dateOnly])
  @@index([schoolId, type, dateOnly])
  @@index([actorId, occurredAt])
}

model AttendanceActivity {
  id             String                   @id @default(uuid())
  schoolId       String
  school         School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear?            @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  dateOnly       String
  code           String
  name           String
  category       String
  startTime      String?
  endTime        String?
  status         AttendanceActivityStatus @default(OPEN)
  createdById    String
  createdBy      User                     @relation("AttendanceActivityCreator", fields: [createdById], references: [id])
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  records        AttendanceActivityRecord[]

  @@unique([schoolId, dateOnly, code])
  @@index([schoolId, dateOnly, status])
  @@index([academicYearId])
}

model AttendanceActivityRecord {
  id           String             @id @default(uuid())
  activityId   String
  activity     AttendanceActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId    String
  student      User               @relation("ActivityAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status       String
  recordedById String
  recordedBy   User               @relation("ActivityAttendanceRecorder", fields: [recordedById], references: [id])
  notes        String?
  recordedAt   DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([activityId, studentId])
  @@index([studentId, recordedAt])
  @@index([recordedById, recordedAt])
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core/legacy fields kept for compatibility with existing teacher workflows.
  nip    String?
  title  String? // Display/legacy academic title.
  phone  String?
  // Legacy compatibility flag. New Wakasek access is stored in WakasekAssignment.
  // During migration, existing true values are mapped to KURIKULUM.
  isWaka Boolean @default(false)

  // Dapodik-aligned PTK profile. All fields are nullable so existing tenants
  // remain valid and schools can complete data progressively.
  nuptk               String?
  gender              String?
  birthPlace          String?
  birthDate           DateTime?
  nik                 String?
  employmentStatus    String?
  ptkType             String?
  frontTitle          String?
  backTitle           String?
  educationLevel      String?
  educationMajor      String?
  certification       String?
  workStartDate       DateTime?
  additionalDuties    String?
  subjectsTaught      String?
  additionalDutyHours Int?
  teachingHours       Int?
  totalTeachingHours  Int?
  studentLoad         String?
  competencies        String?
  jobTitle            String?
  dapodikImportedAt   DateTime?

  @@index([nip])
  @@index([nuptk])
  @@index([nik])
}

model WakasekAssignment {
  id        String      @id @default(uuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role      WakasekRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([schoolId, teacherId, role])
  @@index([schoolId, role])
  @@index([teacherId])
}

model SchoolStaffAssignment {
  id             String                    @id @default(uuid())
  schoolId       String
  school         School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        User                      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  role           SchoolStaffAssignmentRole
  academicYearId String?
  academicYear   AcademicYear?             @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitName       String?
  customTitle    String?
  dutyDays       String[]                  @default([])
  notes          String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([schoolId, role, isActive])
  @@index([schoolId, teacherId, isActive])
  @@index([departmentId, role, isActive])
  @@index([academicYearId, isActive])
}

model FacilityRoom {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              String?
  building          String?
  floor             String?
  responsibleUserId String?
  responsibleUser   User?    @relation("FacilityResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assets        AssetItem[]
  movementsFrom AssetMovement[] @relation("AssetMovementFromRoom")
  movementsTo   AssetMovement[] @relation("AssetMovementToRoom")

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@index([responsibleUserId])
}

model AssetCategory {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets AssetItem[]

  @@unique([schoolId, code])
  @@index([schoolId, name])
}

model AssetItem {
  id                String         @id @default(uuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code              String
  name              String
  categoryId        String?
  category          AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  roomId            String?
  room              FacilityRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?          @relation("AssetResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  brand             String?
  model             String?
  serialNumber      String?
  quantity          Int            @default(1)
  acquisitionDate   DateTime?
  acquisitionSource String?
  acquisitionValue  Decimal?       @db.Decimal(14, 2)
  condition         AssetCondition @default(GOOD)
  status            AssetStatus    @default(ACTIVE)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  maintenances AssetMaintenance[]
  movements    AssetMovement[]

  @@unique([schoolId, code])
  @@index([schoolId, condition, status])
  @@index([schoolId, roomId])
  @@index([categoryId])
  @@index([responsibleUserId])
}

model AssetMaintenance {
  id             String                 @id @default(uuid())
  schoolId       String
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assetId        String
  asset          AssetItem              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue          String
  priority       FollowUpSeverity       @default(MEDIUM)
  status         AssetMaintenanceStatus @default(REPORTED)
  reportedById   String?
  reportedBy     User?                  @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?                  @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reportedAt     DateTime               @default(now())
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  resolutionNote String?
  vendor         String?
  estimatedCost  Decimal?               @db.Decimal(14, 2)
  actualCost     Decimal?               @db.Decimal(14, 2)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([schoolId, status, priority])
  @@index([assetId, status])
  @@index([assignedToId, status])
}

model AssetMovement {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assetId       String
  asset         AssetItem         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          AssetMovementType
  fromRoomId    String?
  fromRoom      FacilityRoom?     @relation("AssetMovementFromRoom", fields: [fromRoomId], references: [id], onDelete: SetNull)
  toRoomId      String?
  toRoom        FacilityRoom?     @relation("AssetMovementToRoom", fields: [toRoomId], references: [id], onDelete: SetNull)
  performedById String?
  performedBy   User?             @relation("AssetMovementActor", fields: [performedById], references: [id], onDelete: SetNull)
  note          String?
  movedAt       DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([schoolId, movedAt])
  @@index([assetId, movedAt])
  @@index([fromRoomId])
  @@index([toRoomId])
  @@index([performedById])
}

model StudentViolation {
  id             String                 @id @default(uuid())
  schoolId       String
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        User                   @relation("ViolationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  category       String
  title          String
